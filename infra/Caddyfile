# Free subdomain via is-a.dev (A record -> the VM's external IP). Caddy
# issues and renews the TLS cert automatically via Let's Encrypt once DNS
# resolves here and ports 80/443 are reachable — no manual cert setup
# needed. Won't work until the is-a.dev registration PR is merged and
# DNS has propagated.
log-anomaly-engine.is-a.dev {
	# The query/streaming API (REST + the /stream/live SSE endpoint) lives
	# under /api/*, with that prefix stripped before forwarding since the
	# API service's own routes (e.g. /status, /demo/inject-spike) have no
	# such prefix themselves.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8001
	}

	# Everything else goes to the Next.js dashboard.
	handle {
		reverse_proxy dashboard:3000
	}
}
